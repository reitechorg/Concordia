		"@inquirer/prompts": "^7.3.2",
		"@paralleldrive/cuid2": "^2.2.2",
		"@prisma/adapter-mariadb": "^7.0.0",
		"@prisma/client": "7.0.0",
		"bcryptjs": "^3.0.2",
