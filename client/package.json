{
	"name": "concordia",
	"version": "0.0.5",
	"description": "Client for Concordia-server instance(s)",
	"type": "module",
	"main": "dist/main.js",
	"scripts": {
		"build-typescript": "tsc",
		"watch-typescript": "tsc --watch",
		"watch-electron": "nodemon --watch dist --exec electron ./dist/main.js",
		"dev": "concurrently \"pnpm watch-typescript\" \"pnpm watch-electron\""
	},
	"repository": {
		"url": "https://github.com/reitechorg/Concordia"
	},
	"keywords": [],
	"author": {
		"name": "REItech",
		"email": "info@reitech.org"
	},
	"homepage": "https://reitech.org/creations/concordia",
	"license": "ISC",
	"packageManager": "pnpm@12.15.0",
	"devDependencies": {
		"@types/express": "^5.0.6",
		"concurrently": "^9.2.5",
		"electron": "^45.4.1",
		"nodemon": "^3.1.14"
	},
	"dependencies": {
		"chalk": "^6.0.1",
		"electron-reload": "2.0.0-alpha.1",
		"electron-store": "^12.0.0",
		"electron-updater": "^6.8.11",
		"express": "^5.3.0",
		"typescript": "^7.0.2"
	},
	"desktopName": "concordia",
	"build": {
		"appId": "com.reitech.concordia",
		"files": [
			"dist/main.js",
			"dist/preload.js",
			{
				"from": "dist/ipc",
				"to": "dist/ipc",
				"filter": [
					"**/*"
				]
			},
			{
				"from": "dist/updates",
				"to": "dist/updates",
				"filter": [
					"**/*"
				]
			},
			{
				"from": "dist/build",
				"to": "dist/build",
				"filter": [
					"**/*"
				]
			},
			{
				"from": "dist/utils",
				"to": "dist/utils",
				"filter": [
					"**/*"
				]
			}
		],
		"win": {
			"publish": [
				"github"
			],
			"target": [
				{
					"target": "nsis",
					"arch": [
						"x64"
					]
				}
			]
		},
		"mac": {
			"publish": [
				"github"
			],
			"target": [
				{
					"target": "dmg",
					"arch": [
						"universal"
					]
				}
			]
		},
		"linux": {
			"publish": [
				"github"
			],
			"target": [
				"AppImage",
				"deb",
				"pacman"
			],
			"category": "Network",
			"mimeTypes": [
				"application/concordia",
				"x-scheme-handler/concordia"
			]
		}
	}
}
